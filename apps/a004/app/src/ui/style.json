{
  "family": "ledger",
  "label": "Ledger — trustworthy & precise",
  "scheme": "light",
  "language": "Bank-grade trust: restrained navy/teal, hairline borders instead of shadows, compact rows, tabular figures everywhere, numbers are the hero (large, right-aligned in lists), green/red ONLY for money in/out. No playful illustrations on data screens, no emoji, no bouncy motion. Charts are clean bars/lines with gridlines.",
  "fonts": {
    "display": "IBMPlexSans_600SemiBold",
    "displayBold": "IBMPlexSans_700Bold",
    "regular": "IBMPlexSans_400Regular",
    "medium": "IBMPlexSans_500Medium",
    "semibold": "IBMPlexSans_600SemiBold",
    "bold": "IBMPlexSans_700Bold"
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "pill": 999
  },
  "space": {
