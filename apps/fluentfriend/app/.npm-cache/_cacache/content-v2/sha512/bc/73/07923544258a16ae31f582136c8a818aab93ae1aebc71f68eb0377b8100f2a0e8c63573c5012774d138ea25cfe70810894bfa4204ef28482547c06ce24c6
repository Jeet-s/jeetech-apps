16:56:12.712Z","0.23.1":"2026-10-24T16:03:11.812Z","0.24.0":"2026-10-25T10:26:28.271Z","0.25.0":"2026-10-27T00:21:45.149Z","0.26.0":"2026-10-27T14:37:38.612Z","0.27.0":"2026-10-27T20:03:33.129Z","0.27.1":"2026-10-28T11:21:40.752Z","0.28.0":"2026-10-29T19:15:52.081Z","0.29.0":"2026-10-30T10:12:57.540Z","0.30.0":"2026-10-31T20:39:45.939Z","0.31.0":"2026-11-01T13:32:34.155Z","0.32.0":"2026-11-04T11:34:08.749Z"},"bugs":{"url":"https://github.com/expo/expo-modules-macros/issues"},"author":{"name":"650 Industries, Inc."},"license":"MIT","homepage":"https://github.com/expo/expo-modules-macros","repository":{"url":"git+https://github.com/expo/expo-modules-macros.git","type":"git","directory":"platforms/linux-x64"},"description":"The Linux x64 binary of expo-modules-macros","maintainers":[{"name":"ide","email":"ide+npm@jameside.com"},{"name":"brentvatne","email":"brentvatne@gmail.com"},{"name":"expoadmin","email":"support@expo.io"},{"name":"exponent","email":"exponent.team@gmail.com"},{"name":"bycedric","email":"me@bycedric.com"},{"name":"kudochien","email":"ckchien@gmail.com"},{"name":"alanhughes","email":"hughesno1@gmail.com"},{"name":"tsapeta","email":"npm@tsapeta.com"},{"name":"expo-bot","email":"brent+expobotnpm@expo.io"},{"name":"philpl","email":"phil@kitten.sh"},{"name":"ccheever","email":"ccheever@gmail.com"},{"name":"szdziedzic","email":"sz.dziedz@gmail.com"},{"name":"wschurman","email":"wschurman@gmail.com"}],"readme":"<p>\n  <a href=\"https://docs.expo.dev/modules/\">\n    <img\n      src=\"https://raw.githubusercontent.com/expo/expo-modules-macros/main/.github/resources/expo-modules-macros.svg\"\n      alt=\"expo-modules-macros\"\n      height=\"64\" />\n  </a>\n</p>\n\n# @expo/modules-macros-linux-x64\n\nThe Linux x64 build of the `expo-modules-macros` compiler plugin and scanner (`ExpoModulesMacros`).\n\nDon't install this package directly. `expo-modules-macros` lists it as an optional dependency, and package managers install it only on Linux x64 with glibc, because of its `os`, `cpu` and `libc` fields. `getScannerBinaryPath()` in `expo-modules-macros` returns the path of the executable in it.\n\nThe Swift runtime is linked in statically, so the executable runs without a Swift toolchain. It needs glibc 2.34 or newer and the GNU C++ runtime (`libstdc++` and `libgcc_s`), for example on Ubuntu 22.04, Debian 12, Red Hat Enterprise Linux 9 or Amazon Linux 2023, or a newer release of one of them. It doesn't run on musl distributions such as Alpine Linux.\n","readmeFilename":"README.md"}